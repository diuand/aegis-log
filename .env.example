# Copy to .env (git-ignored) or let `make setup` create it. Placeholders only.

# Key every client must send as the X-API-Key header (all endpoints except
# /health). `make setup` fills in a random value; empty means "refuse all".
AEGIS_API_KEY=

# Threat-intel provider key (MISP-style). Leave empty: the local feed needs none.
AEGIS_INTEL_API_KEY=

# Optional overrides
# AEGIS_PORT=5000
# AEGIS_DB=var/aegis.sqlite3
